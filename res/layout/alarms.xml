<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/windowBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
      android:paddingTop="16dp" android:paddingBottom="24dp">
    <TextView style="@style/product_page_title" android:text="@string/product_alarms_title" />
    <TextView style="@style/product_page_caption" android:text="@string/product_alarms_caption" />
    <LinearLayout android:id="@+id/add_alarm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:orientation="horizontal" android:gravity="center" android:minHeight="52dp"
        android:padding="14dp" android:background="@drawable/overview_button"
        android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="22dp" android:layout_height="22dp"
          android:layout_marginEnd="10dp" android:src="@drawable/add_alarm"
          android:tint="@color/overview_button_text" android:importantForAccessibility="no" />
      <TextView android:id="@+id/add_alarm_tv" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="@string/add_alarm" android:textSize="16sp"
          android:fontFamily="sans-serif-medium" android:textColor="@color/overview_button_text" />
    </LinearLayout>
    <LinearLayout android:id="@+id/alarms_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="24dp"
        android:orientation="vertical" android:background="@drawable/card_background" android:visibility="gone">
      <ImageView android:layout_width="36dp" android:layout_height="36dp"
          android:layout_marginBottom="16dp" android:src="@drawable/ic_nav_alarms"
          android:tint="@color/overview_green" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/product_alarms_empty_title" android:textSize="21sp"
          android:fontFamily="sans-serif-medium" android:textColor="@color/primary_text" />
      <TextView style="@style/product_page_caption" android:text="@string/product_alarms_empty_caption" />
    </LinearLayout>
    <LinearLayout android:id="@+id/alarms_list" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
