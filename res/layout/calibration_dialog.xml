<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="12dp"
      android:paddingBottom="8dp">

    <TextView
        android:id="@+id/calibration_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:textColor="?android:attr/textColorPrimary" />

    <ProgressBar
        android:id="@+id/calibration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:progressTint="@color/overview_green"
        android:progressBackgroundTint="@color/overview_track"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/calibration_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_background"
        android:visibility="gone">

      <TextView
          style="@style/overview_label"
          android:text="@string/calibration_unit_label" />
      <TextView
          android:id="@+id/calibration_unit"
          style="@style/overview_value"
          android:textSize="17sp" />

      <TextView
          style="@style/overview_label"
          android:layout_marginTop="12dp"
          android:text="@string/calibration_sign_label" />
      <TextView
          android:id="@+id/calibration_sign"
          style="@style/overview_value"
          android:textSize="17sp" />

      <TextView
          style="@style/overview_label"
          android:layout_marginTop="12dp"
          android:text="@string/calibration_drain_label" />
      <TextView
          android:id="@+id/calibration_drain"
          style="@style/overview_value"
          android:textSize="17sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/calibration_dual_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:buttonTint="@color/overview_green"
        android:text="@string/pref_dual_cell_current"
        android:visibility="gone" />
    <TextView
        android:id="@+id/calibration_dual_current_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:textSize="13sp"
        android:textColor="@color/overview_muted"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/calibration_dual_voltage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/overview_green"
        android:text="@string/pref_dual_cell_voltage"
        android:visibility="gone" />
    <TextView
        android:id="@+id/calibration_dual_voltage_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:textSize="13sp"
        android:textColor="@color/overview_muted"
        android:visibility="gone" />
  </LinearLayout>
</ScrollView>
